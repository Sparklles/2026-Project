<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.productmanagement.mapper.CartMapper">

    <!-- 购物车实体结果映射 -->
    <resultMap id="BaseResultMap" type="com.example.productmanagement.entity.Cart">
        <id column="cart_id" property="cartId"/>
        <result column="user_id" property="userId"/>
        <result column="book_id" property="bookId"/>
        <result column="quantity" property="quantity"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 根据用户ID查询购物车列表 -->
    <select id="selectCartListByUserId" resultMap="BaseResultMap">
        SELECT
            cart_id,
            user_id,
            book_id,
            quantity,
            create_time,
            update_time
        FROM cart
        WHERE user_id = #{userId}
        ORDER BY create_time DESC
    </select>

    <!-- 根据用户ID清空购物车 -->
    <delete id="deleteByUserId">
        DELETE FROM cart WHERE user_id = #{userId}
    </delete>

    <!-- 批量删除购物车商品 -->
    <delete id="deleteBatchByIds">
        DELETE FROM cart
        WHERE user_id = #{userId}
        AND cart_id IN
        <foreach collection="cartIds" item="cartId" open="(" separator="," close=")">
            #{cartId}
        </foreach>
    </delete>

    <!-- 根据购物车ID列表分页查询购物车商品 -->
    <select id="selectCartListByIds" resultMap="BaseResultMap">
        SELECT
            cart_id,
            user_id,
            book_id,
            quantity,
            create_time,
            update_time
        FROM cart
        WHERE user_id = #{userId}
        AND cart_id IN
        <foreach collection="cartIds" item="cartId" open="(" separator="," close=")">
            #{cartId}
        </foreach>
        ORDER BY create_time DESC
    </select>

    <!-- 根据用户ID和书籍类别分页查询购物车列表 -->
    <select id="selectCartListByUserIdAndCategoryId" resultMap="BaseResultMap">
        SELECT
            c.cart_id,
            c.user_id,
            c.book_id,
            c.quantity,
            c.create_time,
            c.update_time
        FROM cart c
        INNER JOIN book_info b ON c.book_id = b.id
        WHERE c.user_id = #{userId}
        AND b.category_id = #{categoryId}
        AND b.is_deleted = 0
        ORDER BY c.create_time DESC
    </select>

</mapper>
